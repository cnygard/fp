import numpy as np
import cv2
import matplotlib.pyplot as plt

img = cv2.imread('cat.jpg', cv2.IMREAD_GRAYSCALE)
F = np.fft.fftshift(np.fft.fft2(img))
c = img.shape[0] // 2
F_small = F[c-100:c+100,c-100:c+100]
blur = np.fft.ifft2(np.fft.ifftshift(blur))

fig,axs = plt.subplots(2,2)
axs[0,0].imshow(img)
axs[0,1].imshow(F)
axs[1,0].imshow(blur)
axs[1,1].imshow(F_small)
plt.show()
